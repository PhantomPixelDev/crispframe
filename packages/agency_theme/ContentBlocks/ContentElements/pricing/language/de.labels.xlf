        <target>Bearbeitbare Leistungspakete mit monatlichen und jährlichen Preisen.</target>
      </trans-unit>
      <trans-unit id="headline.label">
        <source>Headline</source>
        <target>Überschrift</target>
      </trans-unit>
      <trans-unit id="lead.label">
        <source>Introduction</source>
        <target>Einleitung</target>
      </trans-unit>
      <trans-unit id="tiers.label">
        <source>Pricing tiers</source>
        <target>Preispakete</target>
      </trans-unit>
      <trans-unit id="tiers.name.label">
        <source>Tier name</source>
        <target>Paketname</target>
      </trans-unit>
      <trans-unit id="tiers.summary.label">
        <source>Short description</source>
        <target>Kurzbeschreibung</target>
      </trans-unit>
      <trans-unit id="tiers.monthlyPrice.label">
        <source>Monthly price</source>
        <target>Monatlicher Preis</target>
      </trans-unit>
      <trans-unit id="tiers.monthlyPrice.description">
        <source>Include the currency symbol, e.g. €950. Use “On request” if needed.</source>
        <target>Währungssymbol angeben, z. B. 950 €. Bei Bedarf „Auf Anfrage“ verwenden.</target>
      </trans-unit>
      <trans-unit id="tiers.yearlyPrice.label">
        <source>Price when billed yearly</source>
        <target>Preis bei jährlicher Abrechnung</target>
      </trans-unit>
      <trans-unit id="tiers.yearlyPrice.description">
        <source>Displayed after the visitor selects Yearly; include the currency symbol.</source>
        <target>Wird bei jährlicher Abrechnung angezeigt; Währungssymbol angeben.</target>
      </trans-unit>
      <trans-unit id="tiers.hideSuffix.label">
        <source>Hide billing suffix</source>
        <target>Abrechnungszusatz ausblenden</target>
      </trans-unit>
      <trans-unit id="tiers.hideSuffix.description">
        <source>Enable for custom quotes such as “On request”.</source>
        <target>Für individuelle Angebote wie „Auf Anfrage“ aktivieren.</target>
      </trans-unit>
      <trans-unit id="tiers.features.label">
        <source>Included features</source>
        <target>Enthaltene Leistungen</target>
      </trans-unit>
      <trans-unit id="tiers.features.description">
        <source>Use a bulleted list. Keep each benefit short and concrete.</source>
        <target>Verwenden Sie eine Liste mit kurzen, konkreten Vorteilen.</target>
      </trans-unit>
      <trans-unit id="tiers.ctaLabel.label">
        <source>Button label</source>
        <target>Schaltflächenbeschriftung</target>

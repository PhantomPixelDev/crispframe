# Crispframe Agency Theme — Site Set TypoScript
# TYPO3 13.4 and 14.3 PAGEVIEW syntax. The PAGE object must exist for TYPO3 to
# render frontend pages ("No page configured for type=0" otherwise).

page = PAGE
page {
    10 = PAGEVIEW
    10 {
        # PAGEVIEW convention: templates in Pages/, partials in Partials/,
        # layouts in Layouts/ below each path.
        paths {
            100 = EXT:agency_theme/Resources/Private/PageView/
        }

        variables {
            currentLanguage = TEXT
            currentLanguage.data = siteLanguage:locale:languageCode
            # Content columns. styles.content.get comes from fluid-styled-content
            # (declared as set dependency in this set's config.yaml).
            contentMain < styles.content.get
            contentMain.select.where = colPos = 0
            contentHero < styles.content.get
            contentHero.select.where = colPos = 1
            contentSidebar < styles.content.get
            contentSidebar.select.where = colPos = 2

        }

        dataProcessing {
            10 = menu
            10 {
                as = menuMain
                titleField = nav_title // title
                expandAll = 1
                includeNotInMenu = 0
            }
            20 = menu
            20 {
                as = menuServices
                special = directory
                special.value.data = site:settings.footer.servicesParent
                titleField = nav_title // title
                includeNotInMenu = 0
                if.isTrue.data = site:settings.footer.servicesParent
            }
            30 = menu
            30 {
                as = breadcrumb
                special = rootline
                special.range = 0|-1
                titleField = nav_title // title
                includeNotInMenu = 0
            }
            40 = language-menu
            40 {
                languages = auto
                as = languageNavigation
            }
        }
    }

    meta {
        viewport = width=device-width, initial-scale=1
        description.data = page:description
        description.ifEmpty.data = site:settings.brand.tagline
        description.ifEmpty.ifEmpty.data = site:settings.brand.companyName
        og:site_name.data = site:settings.brand.companyName
        og:site_name.ifEmpty.data = site:settings.brand.tagline
        og:type = website
        twitter:card = summary
        theme-color = #0f172a
    }
}

tt_content.crispframe_childpages.dataProcessing {
    20 = menu
    20 {
        as = childPages
        special = directory
        special.value.field = crispframe_childpages_parentPage
        titleField = nav_title // title
        includeNotInMenu = 0
        if.isTrue.field = crispframe_childpages_parentPage
    }
    30 = Crispframe\AgencyTheme\DataProcessing\ChildPageMediaProcessor
}

[siteLanguage("locale") == "de_DE"]
page.meta.description.ifEmpty.data = site:settings.brand.taglineDe
[END]

plugin.tx_form.settings.yamlConfigurations.100 = EXT:agency_theme/Configuration/Form/FormSetup.yaml

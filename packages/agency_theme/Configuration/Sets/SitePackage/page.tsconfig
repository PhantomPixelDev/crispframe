# Page TSconfig — Crispframe Agency Theme
# Applied automatically when the Site Set is active.

# ── RTE preset (uses fluid_styled_content defaults; override via custom YAML if needed) ─
RTE.default.preset = default

# Sensible RTE defaults for corporate copy
RTE.default {
    buttons {
        link.properties.class.allowedClasses := addToList(internal-link, external-link)
    }
}

# ── Backend layouts → map to PageView rendering keys ─────────────────
mod.web_layout.BackendLayouts {
    Default {
        title = Default
        icon = EXT:agency_theme/Resources/Public/Icons/sprite.svg
        config {
            backend_layout {
                colCount = 1
                rowCount = 1
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 0
                                identifier = main
                            }
                        }
                    }
                }
            }
        }
    }
    Landing {
        title = Landing
        icon = EXT:agency_theme/Resources/Public/Icons/sprite.svg
        config {
            backend_layout {
                colCount = 1
                rowCount = 2
                rows {
                    1 {
                        columns {
                            1 {
                                name = Hero
                                colPos = 1
                                identifier = hero
                            }
                        }
                    }
                    2 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 0
                                identifier = main
                            }
                        }
                    }
                }
            }
        }
    }
    Article {
        title = Article with sidebar
        icon = EXT:agency_theme/Resources/Public/Icons/sprite.svg
        config {
            backend_layout {
                colCount = 2
                rowCount = 1
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 0
                                identifier = main
                            }
                            2 {
                                name = Sidebar
                                colPos = 2
                                identifier = sidebar
                            }
                        }
                    }
                }
            }
        }
    }
    Minimal {
        title = Minimal
        icon = EXT:agency_theme/Resources/Public/Icons/sprite.svg
        config {
            backend_layout {
                colCount = 1
                rowCount = 1
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 0
                                identifier = main
                            }
                        }
                    }
                }
            }
        }
    }
}

# ── New content element wizard — keep curated ────────────────────────
mod.wizards.newContentElement.wizardItems.common.elements {
    textmedia
    text
    header
    bullets
    table
    uploads
}

# Hide layout/frame clutter for editors; styling is token-driven
TCEFORM.tt_content.layout.disabled = 1
TCEFORM.tt_content.frame_class.disabled = 1

# Show colPos labels clearly
TCEFORM.tt_content.colPos.altLabels.0 = Main content
TCEFORM.tt_content.colPos.altLabels.1 = Hero
TCEFORM.tt_content.colPos.altLabels.2 = Sidebar

# ── Page module: hide arbitrary header layouts editors should not pick ─
# Keep only default + 1-3
TCEFORM.tt_content.header_layout.removeItems = 0,4,5

# ── Disable copy/paste clutter ───────────────────────────────────────
mod.web_layout.localization.enableCopy = 1
mod.web_layout.localization.enableTranslate = 1

{
    "name": "crispframe/dev",
    "description": "Local development project for the Crispframe TYPO3 theme",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/agency_theme",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "crispframe/agency-theme": "@dev",
        "friendsoftypo3/content-blocks": "^2.4",
        "typo3/cms-backend": "^14.3.7",
        "typo3/cms-core": "^14.3.7",
        "typo3/cms-extbase": "^14.3.7",
        "typo3/cms-extensionmanager": "^14.3.7",
        "typo3/cms-felogin": "^14.3.7",
        "typo3/cms-filelist": "^14.3.7",
        "typo3/cms-fluid": "^14.3.7",
        "typo3/cms-fluid-styled-content": "^14.3.7",
        "typo3/cms-form": "^14.3.7",
        "typo3/cms-frontend": "^14.3.7",
        "typo3/cms-impexp": "^14.3.7",
        "typo3/cms-install": "^14.3.7",
        "typo3/cms-redirects": "^14.3.7",
        "typo3/cms-rte-ckeditor": "^14.3.7",
        "typo3/cms-seo": "^14.3.7"
    },
    "extra": {
        "typo3/cms": {
            "app-dir": ".",
            "web-dir": "public"
        }
    }
}
